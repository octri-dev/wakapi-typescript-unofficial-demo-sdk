{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist/**"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "unicorn/no-invalid-fetch-options": "off"
  },
  "overrides": [
    {
      "files": ["test/**/*.mjs"],
      "env": {
        "node": true
      }
    }
  ]
}
